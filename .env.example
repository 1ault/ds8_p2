# =============================================================================
#  Centinela IoT - configuracion del backend
#
#  Copiar a .env y ajustar. Sin .env el sistema arranca igual con valores por
#  defecto (modo local, sin ThingSpeak).
# =============================================================================

# ------------------------------ Panel web ------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_USER=admin
WEB_PASSWORD=seguridad2026
# Cadena usada para firmar la cookie de sesion. CAMBIAR en produccion.
SECRET_KEY=cambia-este-secreto-en-produccion
# 1 = panel abierto sin login (solo para demostraciones)
SIN_LOGIN=0
DEBUG=0

# ------------------------------ Base de datos --------------------------------
# Ruta del archivo SQLite (relativa al proyecto si no es absoluta)
DB_PATH=data/centinela.db
# Dias que se conservan las lecturas antes de la purga automatica
RETENTION_DAYS=30

# ------------------------------ Broker MQTT ----------------------------------
# HiveMQ publico (gratuito) para desarrollo
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=0
# Para HiveMQ Cloud: host del panel, puerto 8883 y MQTT_TLS=1
MQTT_USER=
MQTT_PASSWORD=
# Prefijo de los topicos: <prefijo>/<device>/<canal>
TOPIC_PREFIX=centinela
DEVICE_ID=dev01
# Segundos que se espera el ACK de un comando antes de marcarlo TIMEOUT
MQTT_ACK_TIMEOUT_S=8

# ------------------------------ ThingSpeak -----------------------------------
# Dejar vacio para desactivar la nube (el sistema funciona en local)
THINGSPEAK_CHANNEL=
THINGSPEAK_WRITE_KEY=
THINGSPEAK_READ_KEY=
# Aplicacion TalkBack del canal (comandos desde la nube)
THINGSPEAK_TALKBACK_ID=
THINGSPEAK_TALKBACK_KEY=
# El plan gratuito admite 1 envio cada 15 s; se usa 20 s por seguridad
THINGSPEAK_INTERVAL_S=20
TALKBACK_INTERVAL_S=15
